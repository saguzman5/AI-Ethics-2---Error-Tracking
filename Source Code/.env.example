# Copy this file to ".env" (same folder) and adjust. All settings are optional.

# Network
PORT=3000
HOST=0.0.0.0

# Factory time zone used for all displayed dates and day grouping (IANA name).
TIMEZONE=America/Chicago

# Public address of the server, used in spreadsheet photo links and QR labels.
# Set this when the server is behind a proxy or tunnel, e.g. https://quality.example.com
PUBLIC_URL=

# Set to true when running behind a reverse proxy / tunnel that terminates HTTPS.
TRUST_PROXY=false

# HTTPS directly in this server (needed for phone cameras on a local network
# unless a proxy/tunnel provides HTTPS). Paths to PEM files.
TLS_KEY_FILE=
TLS_CERT_FILE=

# First-run manager account (only used when no manager exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Where the database and photos are stored (default: ../Database/data)
DATA_DIR=

# Reporting rules
REQUIRE_PHOTO=false
AUTO_REGISTER_PRODUCTS=true
DUPLICATE_WINDOW_MINUTES=30
MAX_PHOTO_BYTES=8388608

# Sessions (days)
SESSION_DAYS_WORKER=30
SESSION_DAYS_MANAGER=1

# Days that photo links inside spreadsheets / exports stay valid
PHOTO_LINK_DAYS=30
